# Environment Variables for HeirloomCorp Landing Page

# Webhook or backend endpoint for inquiry form submissions (e.g., Zapier, Make, Formspree, CRM)
# Leave empty to use local verified simulation
VITE_INQUIRY_ENDPOINT=

# Webhook or backend endpoint for newsletter subscribers (e.g., Mailchimp, ConvertKit, Resend)
# Leave empty to use local verified simulation
VITE_NEWSLETTER_ENDPOINT=

# Canonical public production URL
VITE_SITE_URL=https://heirloomcorp.org
